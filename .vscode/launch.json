{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "bos status",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/cli.mjs",
      "args": ["status"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "bos bootstrap (dry run)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/cli.mjs",
      "args": ["bootstrap", "--dry-run"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "tests (vitest)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run"]
    }
  ]
}
